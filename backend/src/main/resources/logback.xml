<configuration debug="true">
    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_PATH:-build/log}/reporter.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <fileNamePattern>${LOG_PATH:-build/log}/reporter.%d.log.gz</fileNamePattern>
            <maxHistory>365</maxHistory>
        </rollingPolicy>
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSSXXX} %5p ${PID:- } --- [%t] [%X{REQUEST_ID:-n/a}] [%X{REQUEST_USER_ID:-n/a}] %-40.40logger{39} : %m%n%ex</pattern>
        </encoder>
        <filter class="ch.qos.logback.classic.filter.ThresholdFilter">
            <level>INFO</level>
        </filter>
    </appender>

    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <target>System.out</target>
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSSXXX} %highlight(%5p) ${PID:- } --- [%t] %yellow([%X{REQUEST_ID:-n/a}]) %blue([%X{REQUEST_USER_ID:-n/a}]) %cyan(%-40.40logger{39}) : %m%n%ex</pattern>
        </encoder>
    </appender>


    <logger name="ch.ergon.tablero" level="INFO"/>
    <root level="INFO">
        <appender-ref ref="STDOUT"/>
    </root>

</configuration>